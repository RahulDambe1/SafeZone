# SafeZone Environment Variables
# Copy this file to .env.local and fill in your values

# ===================================================
# AI ANALYSIS (Optional)
# Get from: https://aistudio.google.com/app/apikey
# If not set: shows "AI ANALYSIS UNAVAILABLE" — no faking
# ===================================================
# GEMINI_API_KEY=AIzaSy...

# ===================================================
# DATABASE (Optional — defaults to in-memory store)
# Create free project at: https://supabase.com
# If not set: incidents reset on server restart, shows "DATABASE NOT CONNECTED"
# ===================================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ===================================================
# MAP PROVIDER (Optional — defaults to OpenStreetMap, no key needed)
# Get from: https://account.mapbox.com/
# ===================================================
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# ===================================================
# RESPONDER GPS FEED (Optional — requires authorized API)
# Only set if you have an authorized emergency dispatch API
# If not set: shows "RESPONDER FEED NOT CONNECTED" — no faking
# ===================================================
# RESPONDER_API_URL=https://your-dispatch-system/api/responders
# RESPONDER_API_KEY=your_api_key

# ===================================================
# ROUTING (Optional — defaults to public OSRM, no key needed)
# ===================================================
# OSRM_BASE_URL=http://router.project-osrm.org
