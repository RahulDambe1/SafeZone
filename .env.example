[TEMPLATE]
# ============================================================================
# SAFEZONE — Environment Configuration
#
# Everything here is OPTIONAL unless marked REQUIRED. SafeZone runs with zero
# configuration (keyless map tiles, OSRM routing, OSM hospital lookup,
# rule-based AI, file persistence) and reports every unconfigured service
# honestly in the UI. Add credentials to upgrade services — never to fake them.
# ============================================================================

# ----------------------------------------------------------------------------
# MAP
# ----------------------------------------------------------------------------
# MapTiler key (from https://cloud.maptiler.com/account/keys/). Set BOTH:
#   NEXT_PUBLIC_MAPTILER_API_KEY → browser tiles (MapTiler dark-v2 basemap)
#   MAPTILER_API_KEY             → server routing + reverse geocoding
# If the key is restricted to certain URLs, add your dev origin (e.g.
# http://localhost:3000/*) and any tunnel domain to the key allowlist, or the
# status panel honestly reports "KEY REJECTED OR RESTRICTED" and the map falls
# back to keyless OSM dark tiles.
# NEXT_PUBLIC_MAPTILER_API_KEY=
# MAPTILER_API_KEY=

# Mapbox alternative: public Mapbox token enables the Mapbox dark-v11 basemap
# (raster) instead of the keyless CARTO dark tiles. Never put a secret token
# here — Mapbox tokens are meant to be public for map rendering.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# ----------------------------------------------------------------------------
# ROUTING + GEOCODING (server-side)
# ----------------------------------------------------------------------------
# Mapbox access token used by the server for Directions and reverse
# geocoding. When set, routing uses Mapbox Directions (label becomes
# TRAFFIC-OPTIMIZED ROUTE only if your account has traffic enabled).
# Without it, routing uses MAPTILER_API_KEY when present, then falls back to
# the public OSRM server (real roads, no traffic data → labeled
# FASTEST ROUTE).
# MAPBOX_ACCESS_TOKEN=

# ----------------------------------------------------------------------------
# AI ANALYSIS (server-side)
# ----------------------------------------------------------------------------
# OpenAI-compatible endpoint + key. When set, incident analysis uses a real
# LLM whose output is deterministically validated. Without it, analysis uses
# the deterministic rule-based engine and is labeled RULE-BASED. If the LLM
# call fails, the system falls back to rules and says so — it never invents
# confidence.
# AI_API_KEY=
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# RESPONDER FEED (authorized integration ONLY)
# ----------------------------------------------------------------------------
# SafeZone will NOT scrape or invent ambulance GPS. To activate live
# responder tracking you must provide an authorized feed. Expected shape:
# either an array or { responders: [...] } of objects with
# { id, type: AMBULANCE|POLICE|FIRE, vehicleId, status,
#   latitude, longitude, heading?, speed?, lastUpdated? }.
# Without these, RESPONDER FEED shows NOT CONNECTED and dispatch requests
# are queued for operator review.
# RESPONDER_API_URL=
# RESPONDER_API_KEY=

# ----------------------------------------------------------------------------
# HOSPITALS
# ----------------------------------------------------------------------------
# Authorized hospital API (name/latitude/longitude/beds when available).
# Without it, hospital locations come from OpenStreetMap Overpass (real
# locations, no capacity data → beds show DATA UNAVAILABLE).
# HOSPITAL_API_URL=
# HOSPITAL_API_KEY=

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
# Default: file driver. Incidents/reports persist to .data/ (gitignored) and
# survive restarts. Optional: Supabase driver.
# SAFEZONE_DATA_DIR=.data
# SAFEZONE_DB_DRIVER=file            # or supabase
# SAFEZONE_SUPABASE_URL=
# SAFEZONE_SUPABASE_SERVICE_KEY=

# ----------------------------------------------------------------------------
# AUTH (REQUIRED FOR PRODUCTION)
# ----------------------------------------------------------------------------
# SafeZone ships a development role gate (x-safezone-role header selected in
# the UI). Production MUST replace this with verified sessions from a real
# auth provider (Supabase Auth / Auth0 / SSO). No env var enables this yet —
# it is a documented security TODO.
